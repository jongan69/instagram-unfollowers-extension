{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instagram complete snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accountId",
    "capturedAt",
    "complete",
    "followers",
    "following"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "accountId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,29}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "complete": {
      "const": true
    },
    "followers": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/account"
      }
    },
    "following": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/account"
      }
    }
  },
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "full_name",
        "profile_pic_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.]{1,30}$"
        },
        "full_name": {
          "type": "string",
          "maxLength": 200
        },
        "profile_pic_url": {
          "type": "string",
          "pattern": "^(https://.*)?$"
        },
        "is_private": {
          "type": "boolean"
        },
        "is_verified": {
          "type": "boolean"
        }
      }
    }
  }
}
